{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "remote-main",
  "description": "主窗口加载远程页面时的权限（remote.urls 必须与窗口实际加载的 URL 完全一致）。",
  "windows": ["main"],
  "local": false,
  "remote": {
    "urls": ["http://127.0.0.1:3080", "https://dsh.example.com"]
  },
  "permissions": ["core:default"]
}
